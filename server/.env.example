# ================================================================
# EduStack Server — Environment Variables TEMPLATE
# ================================================================
# HOW TO USE:
#   1. Copy this file:  cp .env.example .env
#   2. Fill in your real values below.
#   3. NEVER commit .env to GitHub — it's in .gitignore.
#
# RENDER.COM DEPLOYMENT:
#   Add each variable in: Render Dashboard → Your Service → Environment
#   You do NOT need an .env file on Render — just paste values there.
#
# ⚠️  NO spaces around the = sign (PORT=5000, NOT PORT = 5000)
# ================================================================


# ── SERVER ──────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
CLIENT_URL=http://localhost:3000


# ── MONGODB ─────────────────────────────────────────────────────
# Get from: https://cloud.mongodb.com → Connect → Drivers
# Replace <username>, <password>, <cluster>, <dbname> with real values
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/EduStack?appName=Cluster0


# ── JWT ─────────────────────────────────────────────────────────
# Any long random string (min 32 chars). Generate one:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret_string_min_32_chars
JWT_EXPIRES_IN=7d


# ── GOOGLE OAUTH 2.0 ────────────────────────────────────────────
# Get from: https://console.cloud.google.com → APIs & Services → Credentials
#
# ⚠️  CRITICAL: GOOGLE_CALLBACK_URL must be the FULL URL:
#     Development:  http://localhost:3000/auth/google/callback
#     Production:   https://YOUR-APP.onrender.com/auth/google/callback
#
# Also add the callback URL to:
#   Google Cloud Console → OAuth 2.0 Client → Authorized Redirect URIs
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback


# ── CLOUDINARY ──────────────────────────────────────────────────
# Get from: https://cloudinary.com → Dashboard → API Keys
# Folders created automatically on first upload:
#   edustack_profiles/   ← user profile pictures
#   edustack_subjects/   ← subject thumbnail images
#   edustack_resources/  ← notes & PYQ PDF files
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
# OR use combined URL (contains all three above):
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME


# ── RAZORPAY ────────────────────────────────────────────────────
# Get from: https://dashboard.razorpay.com → Settings → API Keys
# Use rzp_test_* keys for development (no real money charged)
# Switch to rzp_live_* keys only in production
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret


# ── NODEMAILER (Gmail SMTP — for OTP emails) ────────────────────
# ⚠️  MAIL_PASS must be a Gmail App Password (16 chars), NOT your Gmail password.
# How to generate an App Password:
#   1. Enable 2-Step Verification: https://myaccount.google.com/security
#   2. Go to: https://myaccount.google.com/apppasswords
#   3. App = "Mail" → Device = "Other (EduStack)" → Generate
#   4. Copy the 16-character code (remove spaces)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your_gmail@gmail.com
MAIL_PASS=abcdefghijklmnop
MAIL_FROM=EduStack <your_gmail@gmail.com>


# ── OTP ─────────────────────────────────────────────────────────
# How long (in minutes) before an OTP expires
OTP_EXPIRES_MIN=10


# ── CORS (Production) ───────────────────────────────────────────
# Add your production domain(s) here (comma-separated).
# Example for Render.com: CORS_ORIGINS=https://your-app.onrender.com
# Leave empty in development (localhost is allowed by default).
CORS_ORIGINS=


# ── ADMIN EMAILS ────────────────────────────────────────────────
# Comma-separated list of emails that get admin role automatically.
# These users can manage subjects, resources, and users.
ADMIN_EMAILS=your_admin_email@gmail.com


# ── RENDER.COM NOTES ────────────────────────────────────────────
# When deploying on Render:
#   1. Set NODE_ENV=production in Render's Environment section
#   2. Set PORT — Render sets this automatically, you can leave it blank
#   3. Set CORS_ORIGINS=https://your-app.onrender.com
#   4. Set GOOGLE_CALLBACK_URL=https://your-app.onrender.com/auth/google/callback
#   5. Add your Render domain to Google OAuth Authorized Redirect URIs
#   6. All other env vars above must be set in Render's dashboard
