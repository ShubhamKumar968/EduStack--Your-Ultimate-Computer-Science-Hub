# ================================================================
# EduStack — Root .gitignore
# ================================================================
# ⚠️  NEVER commit .env files — they contain production secrets.
#     Add all secrets to Render's Environment Variables dashboard.
# ================================================================

# ── Node.js Dependencies ────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# ── Environment Files (NEVER commit these) ──────────────────────
.env
.env.local
.env.*.local
.env.production
.env.staging
server/.env

# ── Build / Temp Artifacts ──────────────────────────────────────
dist/
build/
.cache/
.parcel-cache/

# ── Uploaded Files (stored on Cloudinary, not in git) ───────────
server/uploads/
uploads/

# ── OS Generated Files ──────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ── IDE / Editor Files ──────────────────────────────────────────
.vscode/settings.json
.idea/
*.swp
*.swo
*~

# ── Gemini Agent Data ───────────────────────────────────────────
.gemini/

# ── Test Coverage ───────────────────────────────────────────────
coverage/
